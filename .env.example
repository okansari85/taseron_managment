APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKETD=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_TEXT_MODEL=


FIRE_SUPPRESSION_AI_PROVIDER=


GEMINI_API_KEY=
GEMINI_TEXT_MODEL=

FRONTEND_URL=http://localhost:3000

# PKTakip tanıtım sitesi deneme ödemesi (ödeme altyapısı gelene kadar). Canlıda AÇMAYIN: herkes ücretli paketi bedava alır.
PK_FAKE_PAYMENT=

# PKTakip yerel yapay zeka sunucusu (Ayarlar → Yapay zeka → Yerel sunucu). Örn. vLLM: http://SUNUCU:8000/v1, Ollama: http://localhost:11434/v1
PKTAKIP_LOCAL_BASE_URL=
PKTAKIP_LOCAL_API_KEY=
PKTAKIP_LOCAL_MODEL=openai/gpt-oss-20b
PKTAKIP_LOCAL_REASONING=low
PKTAKIP_LOCAL_TIMEOUT=600
PKTAKIP_LOCAL_JSON_SCHEMA=true
PKTAKIP_LOCAL_VERIFY_SSL=true

# Kısa talimatlar (deneme): tek ekipman raporu kısa talimatla + tür bulma, metin önce pdfium. Kapalıyken mevcut akış.
PKTAKIP_SHORT_PROMPTS=false

# Kısa talimatlar açıkken tesisat raporları Docling ile (tablolar korunarak) okunur; Docling kurulu Python yolu. Boşsa kapalı.
PKTAKIP_DOCLING_PYTHON=
# Sürekli açık Docling servisi (python scripts/pk_docling.py --serve 5011); doluysa betik yerine kullanılır.
PKTAKIP_DOCLING_URL=
